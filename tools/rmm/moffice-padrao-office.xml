<?xml version="1.0" encoding="UTF-8"?>
<!-- Arquivo de associacoes padrao do Windows (DefaultAssociationsConfiguration) - REFERENCIA.
     Forca .docx/.odt -> mTexto, .xlsx/.ods -> mPlanilha e .pptx/.odp -> mSlides a cada logon, para TODOS
     os usuarios da maquina. Os ProgIDs sao registrados pela task "associar" do instalador (moffice.iss): a
     maquina precisa ter o mOffice instalado com essa opcao marcada.
     Aplicado pelo aplicar-padrao-office.ps1 (mass-command do RMM), que traz estas mesmas seis linhas
     (um teste confere que as tres listas - este arquivo, o script e o .iss - batem) e as JUNTA com as
     associacoes que a politica ja tinha (ex.: a do mPDF para .pdf), em vez de sobrescreve-las. -->
<DefaultAssociations>
  <Association Identifier=".docx" ProgId="mOffice.Texto.docx" ApplicationName="mTexto" />
  <Association Identifier=".odt" ProgId="mOffice.Texto.odt" ApplicationName="mTexto" />
  <Association Identifier=".xlsx" ProgId="mOffice.Planilha.xlsx" ApplicationName="mPlanilha" />
  <Association Identifier=".ods" ProgId="mOffice.Planilha.ods" ApplicationName="mPlanilha" />
  <Association Identifier=".pptx" ProgId="mOffice.Slides.pptx" ApplicationName="mSlides" />
  <Association Identifier=".odp" ProgId="mOffice.Slides.odp" ApplicationName="mSlides" />
</DefaultAssociations>
