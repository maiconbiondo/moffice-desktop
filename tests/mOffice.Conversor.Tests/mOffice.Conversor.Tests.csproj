<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Task 7: as medidas pesadas (arquivos de 5/20/50 MB) sao SkippableFact, ligadas por MOFFICE_MEDIDAS=1. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- [Fact]/[Theory] viram [SkippableFact]/[SkippableTheory]: um SkipException (ex.: MotorDeTeste, motor ausente num
         clone do repositorio publico) PULA o teste em vez de falhar. Sem SkipException o comportamento e' o mesmo. -->
    <Using Include="Xunit.SkippableFactAttribute" Alias="FactAttribute" />
    <Using Include="Xunit.SkippableTheoryAttribute" Alias="TheoryAttribute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\mOffice.Conversor\mOffice.Conversor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>