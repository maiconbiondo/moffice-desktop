<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- [Fact]/[Theory] viram [SkippableFact]/[SkippableTheory]: um SkipException (ex.: MotorDeTeste, motor ausente num
         clone do repositorio publico) PULA o teste em vez de falhar. Sem SkipException o comportamento e' o mesmo. -->
    <Using Include="Xunit.SkippableFactAttribute" Alias="FactAttribute" />
    <Using Include="Xunit.SkippableTheoryAttribute" Alias="TheoryAttribute" />
    <!-- UseWPF=true estreita os ImplicitUsings padrao (nao inclui System.IO) - licao do mPDF (observacao 6 do log de skills). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plano 6, Task 2: documentos legados sinteticos (ver Fixtures\legado\ORIGEM.txt). -->
    <None Include="Fixtures\legado\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\mOffice.Nucleo\mOffice.Nucleo.csproj" />
    <ProjectReference Include="..\mOffice.Conversor.Tests\mOffice.Conversor.Tests.csproj" />
  </ItemGroup>

</Project>