<Window x:Class="mOffice.Nucleo.JanelaEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="mOffice" Width="1280" Height="800" WindowStartupLocation="Manual">
    <!-- Linha 0: slot do HOST (BarraDoHost) — a casca pendura ali a FaixaAviso do
         mOffice.Comum. Vazio por padrao: com Content nulo o ContentPresenter mede 0 de altura e a janela fica
         identica ao PoC. Linha 1: o editor. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentPresenter Grid.Row="0" x:Name="SlotBarra" Content="{Binding BarraDoHost, RelativeSource={RelativeSource AncestorType=Window}}" />
        <wv:WebView2 Grid.Row="1" x:Name="Web" />
    </Grid>
</Window>
