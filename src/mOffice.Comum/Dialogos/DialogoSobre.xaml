<Window x:Class="mOffice.Comum.Dialogos.DialogoSobre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="{DynamicResource Fonte.Inter}">
    <!-- ESTRUTURA copiada de src/mPdf.App/Views/SobreDialog.xaml (janela sem moldura + Border
         mOffice.Dialog.Superficie + rodape com Fechar); o CONTEUDO e' a atribuicao do ONLYOFFICE e a lista
         completa de componentes (Atribuicoes.txt, espelho de docs/licencas/INVENTARIO.md).
         Mescla o tema LOCALMENTE — mesma razao do mPDF: Application.Current e' null nas sondas STA que
         constroem o dialogo direto, e os StaticResource mOffice.* tem que resolver no parse. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/mOffice.Comum;component/Temas/mOfficeTema.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource mOffice.Dialog.Superficie}" Margin="16">
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Cor.FundoDialogoRodape}"
                    BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13" Padding="22,16">
                <DockPanel>
                    <!-- Abre {app}\licencas (instalado) ou docs\licencas (desenvolvimento). Sem a pasta, fica
                         desligado (nada de MessageBox num dialogo modal). -->
                    <Button x:Name="BotaoLicencas" DockPanel.Dock="Left" Content="Abrir licenças"
                            Click="AbrirLicencas_Click" Style="{StaticResource mOffice.Button.DialogNeutro}"/>
                    <!-- Só IsCancel (como o SobreDialog do mPDF): quem fecha é o Window, em ShowDialog.
                         Um Click="…Close()" AQUI faria o botão fechar a janela ANTES de o WPF escrever o
                         DialogResult do Cancel — não somar um caminho de fechamento ao que já existe. -->
                    <Button Content="Fechar" HorizontalAlignment="Right" IsCancel="True"
                            Style="{StaticResource mOffice.Button.DialogCancelar}"/>
                </DockPanel>
            </Border>

            <StackPanel Margin="24,24,24,16">
                <!-- Cabecalho: logo do app + "<NomeExibicao> <versao>" + subtitulo (arrasta a janela). -->
                <StackPanel Orientation="Horizontal" MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                    <Image x:Name="LogoImagem" Width="52" Height="52" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TituloTexto" FontWeight="Bold" FontSize="18"
                                   Foreground="{DynamicResource Cor.TextoPrimario}"/>
                        <TextBlock x:Name="SubtituloTexto" FontSize="12"
                                   Foreground="{DynamicResource Cor.TextoSecundario}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Atribuicao AGPL/marca do ONLYOFFICE (obrigacao da licenca; texto montado no construtor
                     com a versao do motor) e o link do codigo-fonte. -->
                <TextBlock x:Name="AtribuicaoTexto" TextWrapping="Wrap" Margin="0,18,0,0" FontSize="11.5" LineHeight="18"
                           Foreground="{DynamicResource Cor.TextoSecundario}"/>
                <TextBlock x:Name="FonteTexto" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11.5" LineHeight="18"
                           Foreground="{DynamicResource Cor.TextoSecundario}"/>

                <TextBlock Text="Componentes redistribuídos" Margin="0,16,0,6" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Cor.TextoPrimario}"/>
                <Border BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource mOffice.ScrollViewer.Fino}">
                        <ItemsControl x:Name="ListaComponentes" Margin="12,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Componente}" FontSize="11.5" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Cor.TextoPrimario}"/>
                                        <TextBlock Text="{Binding Detalhe, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Cor.TextoSecundario}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
