<Window x:Class="mOffice.Comum.Dialogos.DialogoConfiguracoes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:mOffice.Comum.Icones"
        Title="Configurações" Width="500" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="{DynamicResource Fonte.Inter}">
    <!-- ESTRUTURA copiada de src/mPdf.App/Views/ConfiguracoesDialog.xaml (header com icone-gradiente +
         titulo/subtitulo arrastavel, corpo, rodape com Fechar); o CONTEUDO e' o da suite: tema (3 opcoes)
         e o grampo de log da ponte. DataContext = DialogoConfiguracoesViewModel.
         Tema mesclado LOCALMENTE (Application.Current e' null nas sondas STA). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/mOffice.Comum;component/Temas/mOfficeTema.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource mOffice.Dialog.Superficie}" Margin="16">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="Transparent" BorderBrush="{DynamicResource Cor.BordaSutil}"
                    BorderThickness="0,0,0,1" Padding="22,18" MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource mOffice.Dialog.IconeHeader}">
                        <TextBlock FontFamily="{DynamicResource Fonte.PhosphorFill}" FontSize="17" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="{icons:PhosphorIcon gear-six}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="Configurações" Style="{StaticResource mOffice.Dialog.Titulo}"/>
                        <TextBlock Text="Nome, pastas, tema e atualizações" Style="{StaticResource mOffice.Dialog.Subtitulo}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Cor.FundoDialogoRodape}"
                    BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13" Padding="22,16">
                <!-- Só IsCancel, como o mPDF: nada de Click adicional fechando por fora. -->
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Fechar" HorizontalAlignment="Right" IsCancel="True"
                            Style="{StaticResource mOffice.Button.DialogCancelar}"/>
                    <TextBlock Text="Nome, pastas e formato valem para as próximas janelas." TextWrapping="Wrap" VerticalAlignment="Center"
                               Margin="0,0,12,0" Foreground="{DynamicResource Cor.TextoSecundario}"/>
                </DockPanel>
            </Border>

            <!-- Corpo rola quando a janela nao cabe na tela (cabecalho e rodape ficam fixos; MaxHeight no code-behind). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,22">
                <!-- Geral (Plano 6, Task 4): nome do autor (autor de comentarios e alteracoes controladas) e tema.
                     Cada set grava no config na hora e vale para janelas NOVAS. -->
                <TextBlock Text="Geral" Style="{StaticResource mOffice.Dialog.LabelForte}"/>
                <TextBlock Text="Nome do autor" Style="{StaticResource mOffice.Dialog.Label}"/>
                <Grid>
                    <TextBox Text="{Binding NomeUsuario, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource mOffice.Input}"/>
                    <TextBlock Text="{Binding NomeEfetivo, Mode=OneWay}" IsHitTestVisible="False" Margin="10,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Cor.TextoSecundario}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NomeUsuario}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="Aparece nos comentários e nas alterações controladas." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Cor.TextoSecundario}"/>

                <TextBlock Text="Tema" Style="{StaticResource mOffice.Dialog.LabelForte}" Margin="0,16,0,0"/>
                <UniformGrid Columns="3">
                    <RadioButton GroupName="Tema" Style="{StaticResource mOffice.Segmento}" Margin="0,0,4,0"
                                 Content="Seguir o Windows" IsChecked="{Binding Sistema}"/>
                    <RadioButton GroupName="Tema" Style="{StaticResource mOffice.Segmento}" Margin="4,0"
                                 Content="Claro" IsChecked="{Binding Claro}"/>
                    <RadioButton GroupName="Tema" Style="{StaticResource mOffice.Segmento}" Margin="4,0,0,0"
                                 Content="Escuro" IsChecked="{Binding Escuro}"/>
                </UniformGrid>

                <Border BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="0,1,0,0" Margin="0,20,0,18"/>

                <TextBlock Text="Salvar" Style="{StaticResource mOffice.Dialog.LabelForte}"/>
                <TextBlock Text="Pasta padrão para salvar documentos novos" Style="{StaticResource mOffice.Dialog.Label}"/>
                <Grid>
                    <TextBox Text="{Binding PastaPadraoSalvar, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource mOffice.Input}" Margin="0,0,96,0"/>
                    <TextBlock Text="{Binding PastaDocumentos, Mode=OneWay}" IsHitTestVisible="False" Margin="10,0,106,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Cor.TextoSecundario}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PastaPadraoSalvar}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" Content="Procurar…" Width="88" Command="{Binding ProcurarPastaSalvarCommand}" Style="{StaticResource mOffice.Button.DialogSuaveAzul}"/>
                </Grid>

                <TextBlock Text="Formato padrão" Style="{StaticResource mOffice.Dialog.Label}" Margin="0,12,0,4"/>
                <RadioButton GroupName="FormatoNovo" Style="{StaticResource mOffice.Segmento}" Margin="0,0,0,4"
                             Content="Formatos do Microsoft Office (.docx, .xlsx, .pptx)" IsChecked="{Binding FormatoOoxml}"/>
                <RadioButton GroupName="FormatoNovo" Style="{StaticResource mOffice.Segmento}"
                             Content="OpenDocument (.odt, .ods, .odp)" IsChecked="{Binding FormatoOpenDocument}"/>

                <Border BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="0,1,0,0" Margin="0,20,0,18"/>

                <TextBlock Text="Modelos" Style="{StaticResource mOffice.Dialog.LabelForte}"/>
                <TextBlock Text="Pasta de modelos pessoais" Style="{StaticResource mOffice.Dialog.Label}"/>
                <Grid>
                    <TextBox Text="{Binding PastaModelos, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource mOffice.Input}" Margin="0,0,96,0"/>
                    <TextBlock Text="{Binding PastaModelosPadrao, Mode=OneWay}" IsHitTestVisible="False" Margin="10,0,106,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Cor.TextoSecundario}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PastaModelos}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" Content="Procurar…" Width="88" Command="{Binding ProcurarPastaModelosCommand}" Style="{StaticResource mOffice.Button.DialogSuaveAzul}"/>
                </Grid>

                <Border BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="0,1,0,0" Margin="0,20,0,18"/>

                <!-- Atualizacoes (Plano 5, Task 2): SO' sob demanda — nada verifica sozinho. A rede so' acontece
                     no clique (VerificarAtualizacoesCommand); a mensagem mostra o resultado em pt-BR. -->
                <TextBlock Text="Atualizações" Style="{StaticResource mOffice.Dialog.LabelForte}"/>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Verificar atualizações" Margin="12,0,0,0"
                            Command="{Binding VerificarAtualizacoesCommand}"
                            Style="{StaticResource mOffice.Button.DialogSuaveAzul}"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Cor.TextoSecundario}">
                        <Run Text="Versão instalada:"/> <Run Text="{Binding VersaoInstalada, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
                <TextBlock Text="{Binding MensagemAtualizacao}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource Cor.TextoPrimario}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border BorderBrush="{DynamicResource Cor.BordaSutil}" BorderThickness="0,1,0,0" Margin="0,20,0,14"/>

                <!-- Diagnostico: coisa de suporte, escondida do usuario final. O link revela a caixa do grampo da ponte
                     (desligado por padrao; so' vale para janelas novas: o grampo e' lido quando a ponte da janela e' montada). -->
                <Button Content="Mostrar opções de diagnóstico" HorizontalAlignment="Left"
                        Command="{Binding MostrarDiagnosticoCommand}"
                        x:Name="LinkDiagnostico">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource mOffice.Button.DialogNeutro}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DiagnosticoVisivel}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <CheckBox Content="Registrar chamadas da ponte no log (diagnóstico; só vale para janelas novas)"
                          IsChecked="{Binding Grampo}" x:Name="CaixaGrampo">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource mOffice.Check}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DiagnosticoVisivel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
